{
  "schemaVersion": 1,
  "id": "nocheck",
  "version": "${version}",
  "name": "No Registry Check",
  "description": "让没装模组的客户端也能进 NoN 服务器：把所有注册表标成可选，并跳过 NoN 的版本握手检查。",
  "authors": ["Dafeiyu"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.dafeiyu.nocheck.NoCheckMod"]
  },
  "mixins": [
    "nocheck.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.2",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
