  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.dafeiyu.nocheck.NoCheckMod"]
  },
  "depends": {
    "fabricloader": ">=0.18.2",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
